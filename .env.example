# Copy to .env and edit. Environment variables override config.yaml.

# ---- LLM (local only - no cloud API keys anywhere) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# OLLAMA_TIMEOUT=300
# OLLAMA_TEMPERATURE=0.2
# OLLAMA_NUM_CTX=8192

# ---- Speech to text ----
WHISPER_MODEL=base
# WHISPER_DEVICE=auto          # auto | cuda | cpu
# WHISPER_COMPUTE_TYPE=auto    # auto | float16 | int8_float16 | int8 | float32
# WHISPER_LANGUAGE=en          # leave unset to auto-detect

# ---- Clip selection ----
TARGET_CLIP_DURATION=30
MIN_CLIP_DURATION=25
MAX_CLIP_DURATION=35
# CLIPS_PER_VIDEO=1

# ---- Output ----
OUTPUT_DIR=./output
WORKSPACE_DIR=./workspace
VIDEO_FORMATS=16:9,9:16
# SUBTITLES_ENABLED=true
# BURN_IN_SUBTITLES=true
# SUBTITLE_FONT_SIZE=48
# SMART_CROP=true

# ---- Runtime ----
KEEP_TEMP_FILES=false
USE_CACHE=true
LOG_LEVEL=INFO
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# On Windows, if ffmpeg is not on PATH:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# ---- Downloads ----
# YTDLP_FORMAT=bestvideo[height<=1080]+bestaudio/best[height<=1080]/best
# YTDLP_COOKIES_FROM_BROWSER=chrome   # for age-restricted videos
# HTTP_PROXY_URL=
